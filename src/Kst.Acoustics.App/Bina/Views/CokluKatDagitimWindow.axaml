<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kst.Acoustics.App.Bina.Views.CokluKatDagitimWindow"
        x:CompileBindings="False"
        Width="660" Height="540"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#060E14"
        Title="Çoklu Kat Dağıtımı">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Başlık -->
        <Border Grid.Row="0"
                Background="#0A1620"
                BorderBrush="#132A3C"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <TextBlock Text="Çoklu Kat Planı Tespit Edildi"
                       Foreground="#A8D4EC" FontSize="14" FontWeight="SemiBold"/>
        </Border>

        <TextBlock Grid.Row="1"
                   x:Name="AciklamaText"
                   Foreground="#7894A8" FontSize="11.5" TextWrapping="Wrap"
                   Margin="14,10,14,6"/>

        <!-- Satır listesi -->
        <ScrollViewer Grid.Row="2" Margin="14,0,14,10">
            <ItemsControl x:Name="SatirList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0A1620"
                                BorderBrush="#132A3C"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,0,0,8"
                                Padding="10,8">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <CheckBox Grid.Column="0" IsChecked="{Binding Dahil}" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBox Text="{Binding Ad}"
                                             Background="#0E2233" Foreground="White"
                                             BorderBrush="#20C3D8" BorderThickness="1"
                                             FontSize="12" Padding="6,3"
                                             IsEnabled="{Binding Dahil}"/>
                                    <TextBlock Text="{Binding BboxOzet}" Foreground="#5E8098" FontSize="10"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Sıra" Foreground="#5E8098" FontSize="9"/>
                                    <NumericUpDown Value="{Binding Sira}"
                                                   Increment="1" FormatString="0.##"
                                                   Width="90"
                                                   Background="#0E2233" Foreground="White"
                                                   BorderBrush="#20C3D8" BorderThickness="1"
                                                   IsEnabled="{Binding Dahil}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Spacing="2">
                                    <TextBlock Text="Yükseklik (m)" Foreground="#5E8098" FontSize="9"/>
                                    <NumericUpDown Value="{Binding YukseklikM}"
                                                   Increment="0.1" Minimum="0.1" FormatString="0.00"
                                                   Width="100"
                                                   Background="#0E2233" Foreground="White"
                                                   BorderBrush="#20C3D8" BorderThickness="1"
                                                   IsEnabled="{Binding Dahil}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="4"
                                           Text="{Binding EtiketDurumu}"
                                           Foreground="#E0A030"
                                           FontSize="10"
                                           Width="76"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Alt buton çubuğu -->
        <Border Grid.Row="3"
                Background="#0A1620"
                BorderBrush="#132A3C"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Sıra: büyük değer = daha yüksek kat. Onaylanınca katlar listeye ▲ üst → ▼ alt sırayla eklenir."
                           Foreground="#4A7898" FontSize="10"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="İptal" Click="Iptal_OnClick"
                            Background="#0D2535" BorderBrush="#1A5070" Foreground="#C8E4F4"
                            Padding="14,6" FontSize="12"/>
                    <Button Content="Katlara Dağıt" Click="Onayla_OnClick"
                            Background="#0E5B82" BorderBrush="#1A8BBF" Foreground="White"
                            FontWeight="SemiBold" Padding="14,6" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
