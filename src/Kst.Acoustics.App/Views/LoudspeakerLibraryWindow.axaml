<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kst.Acoustics.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Kst.Acoustics.App.Views.LoudspeakerLibraryWindow"
        x:DataType="vm:LoudspeakerLibraryWindowViewModel"
        Width="820" Height="540"
        MinWidth="700" MinHeight="420"
        Background="#0E1824"
        Title="Hoparlör Kütüphanesi">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Background="#091320" Padding="14,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="150" Height="44" CornerRadius="6" Background="#F5F8FB" BorderBrush="#DCE7EF" BorderThickness="1" Padding="6,3" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="36,*" ColumnSpacing="6">
                        <Grid Width="36" Height="28">
                            <Ellipse Width="30" Height="20" Stroke="#0B547B" StrokeThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="18" Height="18" Fill="#20C3D8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Path Data="M9,14 L12,14 M15,10 L15,18 M18,7 L18,21 M21,11 L21,17 M24,14 L27,14"
                                  Stroke="#0A4C72"
                                  StrokeThickness="1.2"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="EYE4PRO" Foreground="#0B4568" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="AKUSTİK" Foreground="#18A7BD" FontSize="7" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="Hoparlör Kütüphanesi"
                           FontSize="15" FontWeight="Bold"
                           Foreground="#E0EFFF" VerticalAlignment="Center"/>
                <Border Width="1" Background="#1A3050" Margin="4,0"/>

                <Button Content="CF1/CLF'den Al"
                        Click="ImportButton_OnClick"
                        Background="#1A2A40"
                        Foreground="#80A8D0"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="10,5"
                        FontSize="12"/>

                <Button Content="Sil"
                        Click="DeleteButton_OnClick"
                        IsEnabled="{Binding CanDelete}"
                        Background="#3A1A1A"
                        Foreground="#E08080"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="10,5"
                        FontSize="12"/>

                <Button Content="✕ Kapat"
                        Click="CloseButton_OnClick"
                        Background="#2A1A1A"
                        Foreground="#E07070"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="10,5"
                        FontSize="12"
                        Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#0C1826" CornerRadius="10" Margin="10,8">
            <Grid RowDefinitions="Auto,*">
                <Border Background="#0D1E30" CornerRadius="10,10,0,0" Padding="8,6">
                    <Grid ColumnDefinitions="180,*,90,80">
                        <TextBlock Text="Üretici" FontSize="10" FontWeight="SemiBold" Foreground="#40607A"/>
                        <TextBlock Grid.Column="1" Text="Model" FontSize="10" FontWeight="SemiBold" Foreground="#40607A"/>
                        <TextBlock Grid.Column="2" Text="1 kHz" FontSize="10" FontWeight="SemiBold" Foreground="#40607A" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Çöz." FontSize="10" FontWeight="SemiBold" Foreground="#40607A" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LoudspeakerRowViewModel">
                                <Border Padding="8,7"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="#0D1E30"
                                        PointerPressed="Row_PointerPressed"
                                        Cursor="Hand">
                                    <Grid ColumnDefinitions="180,*,90,80">
                                        <TextBlock Text="{Binding Manufacturer}"
                                                   FontSize="12"
                                                   Foreground="#80A8C8"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ModelName}"
                                                   FontSize="12"
                                                   Foreground="#D0E8FF"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SensitivityMid}"
                                                   FontSize="11"
                                                   Foreground="#E0D080"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Resolution}"
                                                   FontSize="11"
                                                   Foreground="#8098B0"
                                                   HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#091320" Padding="12,7">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#7090A8"/>
        </Border>
    </Grid>
</Window>
