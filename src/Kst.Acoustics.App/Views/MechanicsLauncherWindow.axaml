<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kst.Acoustics.App.Views.MechanicsLauncherWindow"
        Width="1120" Height="760"
        MinWidth="940" MinHeight="640"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        Title="Eye4Pro Mekanik - Modül Merkezi">

    <Window.Styles>
        <Style Selector="Button.moduleAction">
            <Setter Property="Background" Value="#8A5A20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="TextBlock.moduleTitle">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFF1DC"/>
        </Style>
        <Style Selector="TextBlock.moduleMeta">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#C78B40"/>
        </Style>
        <Style Selector="TextBlock.moduleBody">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#D7B57F"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" BorderBrush="#2D2012" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#0D1117" Offset="0"/>
                    <GradientStop Color="#17120D" Offset="0.55"/>
                    <GradientStop Color="#0D1117" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18" Margin="28,18">
                <Border Width="230" Height="76" CornerRadius="8"
                        Background="#FAF7F2"
                        BorderBrush="#EADDCB"
                        BorderThickness="1"
                        ClipToBounds="True"
                        VerticalAlignment="Center">
                    <Grid ColumnDefinitions="60,*" ColumnSpacing="10" Margin="12,8">
                        <Grid Width="60" Height="48">
                            <Ellipse Width="48" Height="30" Stroke="#784B19" StrokeThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="28" Height="28" Fill="#F2A33A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Path Data="M27,12 L32,16 L30,22 L36,25 L34,31 L28,30 L24,35 L18,32 L20,26 L15,22 L20,17 Z"
                                  Fill="#653E15"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="EYE4PRO" Foreground="#603B13" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="MEKANİK" Foreground="#D78623" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Mekanik Tasarım Platformu"
                               Foreground="#FFF1DC"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="HVAC, tesisat hesapları ve mekanik proje iş akışı"
                               Foreground="#B8823E"
                               FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

                    <Button Content="Ana Sayfa"
                            Click="BackToEngineeringHome_OnClick"
                            Background="#15120E"
                            BorderBrush="#2D2012"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,7"
                            Foreground="#D7B57F"
                            FontSize="12"
                            FontWeight="SemiBold"/>
                    <Border Background="#15120E"
                            BorderBrush="#2D2012"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,7">
                        <TextBlock Text="Mekanik Engine v0.1"
                                   Foreground="#D19B55"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="300,*" ColumnSpacing="22" Margin="28,24,28,16">
                <Border Background="#12151A"
                        BorderBrush="#2D2012"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Modül Merkezi"
                                       Foreground="#FFF1DC"
                                       FontSize="19"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Mekanik mühendisliği modülleri için başlangıç çalışma alanı"
                                       Foreground="#B8823E"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Height="1" Background="#2D2012"/>

                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#F2A33A" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Kanal hesabı" Foreground="#E6C28A" FontSize="13"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#F2A33A" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Hava debisi ve basınç kaybı" Foreground="#E6C28A" FontSize="13"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#7D643F" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Pompa ve fan seçimi" Foreground="#B7945E" FontSize="13"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#7D643F" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Isı kaybı / kazancı" Foreground="#B7945E" FontSize="13"/>
                            </Grid>
                        </StackPanel>

                        <Border Background="#15120E"
                                BorderBrush="#2D2012"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Durum"
                                           Foreground="#B8823E"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="1 başlatılan modül, 3 planlanan modül"
                                           Foreground="#FFF1DC"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <UniformGrid Grid.Column="1" Columns="2" Rows="3">
                    <Border Margin="0,0,10,10" Background="#141820" CornerRadius="8" BorderBrush="#8A5A20" BorderThickness="1" Padding="18">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,14">
                                <Border Width="44" Height="44" CornerRadius="8" Background="#332313">
                                    <TextBlock Text="KH" Foreground="#F2A33A" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Classes="moduleTitle" Text="Kanal Hesabı"/>
                                    <TextBlock Classes="moduleMeta" Text="HVAC hava kanalı boyutlandırma"/>
                                </StackPanel>
                            </Grid>
                            <Button DockPanel.Dock="Bottom" Classes="moduleAction" IsEnabled="False" Content="Başlatılıyor"/>
                            <TextBlock Classes="moduleBody" Text="Debi, hız, kanal kesiti, eşdeğer çap ve basınç kaybı hesabı için ilk mekanik modül kapsamı açıldı."/>
                        </DockPanel>
                    </Border>

                    <Border Margin="10,0,0,10" Background="#11151C" CornerRadius="8" BorderBrush="#3A3022" BorderThickness="1" Padding="18" Opacity="0.86">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,14">
                                <Border Width="44" Height="44" CornerRadius="8" Background="#262018">
                                    <TextBlock Text="PF" Foreground="#B7945E" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Classes="moduleTitle" Text="Pompa / Fan Seçimi"/>
                                    <TextBlock Classes="moduleMeta" Text="Planlama"/>
                                </StackPanel>
                            </Grid>
                            <Border DockPanel.Dock="Bottom" Background="#262018" CornerRadius="6" Padding="12,7" HorizontalAlignment="Right">
                                <TextBlock Text="Planlama" Foreground="#B7945E" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Classes="moduleBody" Text="Çalışma noktası, verim, motor gücü ve seçim raporu için ayrılmış modül alanı."/>
                        </DockPanel>
                    </Border>

                    <Border Margin="0,10,10,10" Background="#11151C" CornerRadius="8" BorderBrush="#3A3022" BorderThickness="1" Padding="18" Opacity="0.86">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,14">
                                <Border Width="44" Height="44" CornerRadius="8" Background="#262018">
                                    <TextBlock Text="IK" Foreground="#B7945E" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Classes="moduleTitle" Text="Isı Kaybı / Kazancı"/>
                                    <TextBlock Classes="moduleMeta" Text="Planlama"/>
                                </StackPanel>
                            </Grid>
                            <Border DockPanel.Dock="Bottom" Background="#262018" CornerRadius="6" Padding="12,7" HorizontalAlignment="Right">
                                <TextBlock Text="Planlama" Foreground="#B7945E" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Classes="moduleBody" Text="Mahal bazlı yük hesabı, dış hava koşulları ve raporlama akışı için ayrılmış modül alanı."/>
                        </DockPanel>
                    </Border>

                    <Border Margin="10,10,0,10" Background="#11151C" CornerRadius="8" BorderBrush="#3A3022" BorderThickness="1" Padding="18" Opacity="0.86">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,14">
                                <Border Width="44" Height="44" CornerRadius="8" Background="#262018">
                                    <TextBlock Text="MT" Foreground="#B7945E" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Classes="moduleTitle" Text="Mekanik Tesisat"/>
                                    <TextBlock Classes="moduleMeta" Text="Planlama"/>
                                </StackPanel>
                            </Grid>
                            <Border DockPanel.Dock="Bottom" Background="#262018" CornerRadius="6" Padding="12,7" HorizontalAlignment="Right">
                                <TextBlock Text="Planlama" Foreground="#B7945E" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Classes="moduleBody" Text="Kolon şeması, cihaz listesi, boru/kanal metrajı ve keşif hazırlığı için ayrılmış modül alanı."/>
                        </DockPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="#2D2012" BorderThickness="0,1,0,0" Padding="18,10">
            <TextBlock Text="Mekanik modül ailesi aktif. İlk uygulama alanı M21 Kanal Hesabı olarak başlatıldı."
                       Foreground="#B8823E"
                       FontSize="12"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
