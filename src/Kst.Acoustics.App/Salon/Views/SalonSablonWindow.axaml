<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kst.Acoustics.App.Salon.Views.SalonSablonWindow"
        Width="540" Height="640"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0B1118"
        Title="Hazır Salon Şablonu">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0B131C"/>
            <Setter Property="Foreground" Value="#DCE7F0"/>
            <Setter Property="BorderBrush" Value="#27465C"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#0B131C"/>
            <Setter Property="Foreground" Value="#DCE7F0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TextBlock.lbl">
            <Setter Property="Foreground" Value="#9DB3C4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.head">
            <Setter Property="Foreground" Value="#7E99AD"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="18">
        <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,12">
            <TextBlock Text="Hazır Salon Şablonu" Foreground="#E6EEF6" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Sadece ölçü ve tip seçin; salon dış hattı, sahne ve seyirci otomatik oluşturulur."
                       Foreground="#7E94A7" FontSize="11.5" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="0,0,6,0">

                <TextBlock Classes="head" Text="SALON"/>
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto" ColumnSpacing="10">
                    <TextBlock Classes="lbl" Text="Plan tipi"/>
                    <ComboBox x:Name="SalonTipCombo" Grid.Column="1" SelectedIndex="0">
                        <ComboBoxItem>Dikdörtgen</ComboBoxItem>
                        <ComboBoxItem>At Nalı</ComboBoxItem>
                        <ComboBoxItem>Yelpaze</ComboBoxItem>
                    </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Classes="lbl" Text="Genişlik (m)"/>
                        <TextBox x:Name="SalonGenislikText" Text="24"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Classes="lbl" Text="Derinlik (m)"/>
                        <TextBox x:Name="SalonDerinlikText" Text="30"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Classes="lbl" Text="Yükseklik (m)"/>
                        <TextBox x:Name="SalonYukText" Text="10"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="#1D2B38"/>

                <TextBlock Classes="head" Text="SAHNE"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Classes="lbl" Text="Tip"/>
                        <ComboBox x:Name="SahneTipCombo" SelectedIndex="0">
                            <ComboBoxItem>Dikdörtgen</ComboBoxItem>
                            <ComboBoxItem>Dairesel</ComboBoxItem>
                            <ComboBoxItem>Oval</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Classes="lbl" Text="Konum"/>
                        <ComboBox x:Name="SahneKonumCombo" SelectedIndex="0">
                            <ComboBoxItem>Salon içi</ComboBoxItem>
                            <ComboBoxItem>Salon önü</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Classes="lbl" Text="Genişlik (m)"/>
                        <TextBox x:Name="SahneGenislikText" Text="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Classes="lbl" Text="Derinlik (m)"/>
                        <TextBox x:Name="SahneDerinlikText" Text="8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Classes="lbl" Text="Yükseklik (m)"/>
                        <TextBox x:Name="SahneYukText" Text="1.0"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="#1D2B38"/>

                <TextBlock Classes="head" Text="SEYİRCİ"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Classes="lbl" Text="Kademe sayısı"/>
                        <TextBox x:Name="SeyirciKademeText" Text="8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Classes="lbl" Text="Kademe yük. (m)"/>
                        <TextBox x:Name="SeyirciYukText" Text="0.5"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
            <Button Content="İptal" Click="Iptal_OnClick"
                    Background="#0D2535" BorderBrush="#1A5070" Foreground="#C8E4F4" Padding="16,8" CornerRadius="6"/>
            <Button Content="Oluştur" Click="Olustur_OnClick"
                    Background="#0E5B82" BorderBrush="#1A8BBF" Foreground="White" FontWeight="SemiBold" Padding="18,8" CornerRadius="6"/>
        </StackPanel>
    </Grid>
</Window>
