<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:salon="clr-namespace:Kst.Acoustics.App.Salon.Views"
        x:Class="Kst.Acoustics.App.Salon.Views.SalonAnalizWindow"
        x:CompileBindings="False"
        Width="1120" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#0B1118" Title="Salon Tasarım ve Akustik Kontrol Merkezi">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Padding="16,12" Background="#101B25" BorderBrush="#263949" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel>
          <TextBlock Text="Tasarım ve Akustik Kontrol Merkezi" Foreground="#E4EDF4" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Koltuk, görüş, kesit, kaba RT60, kalite ve reflektörleri tek yerde denetleyin." Foreground="#7891A4" FontSize="11"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Yenile" Click="Yenile_OnClick" Padding="14,7"/>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="12">
      <TabItem Header="Özet">
        <Grid RowDefinitions="Auto,*" Margin="12" RowSpacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Kullanım:" Foreground="#AFC0CD" VerticalAlignment="Center"/>
            <ComboBox x:Name="KullanimCombo" Width="180" SelectedIndex="2" SelectionChanged="Kullanim_SelectionChanged">
              <ComboBoxItem Content="Konuşma"/><ComboBoxItem Content="Müzik"/>
              <ComboBoxItem Content="Çok amaçlı"/><ComboBoxItem Content="Sinema"/>
            </ComboBox>
          </StackPanel>
          <TextBox x:Name="OzetText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   Background="#0D1720" Foreground="#D6E3EC" BorderBrush="#263949"/>
        </Grid>
      </TabItem>

      <TabItem Header="Koltuk ve Görüş">
        <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="8">
          <ComboBox x:Name="SekciyonCombo" Width="300" HorizontalAlignment="Left"
                    SelectionChanged="Sekciyon_SelectionChanged"/>
          <Border Grid.Row="1" BorderBrush="#263949" BorderThickness="1" CornerRadius="7">
            <salon:SalonGorusHaritasiCanvas x:Name="GorusCanvas"/>
          </Border>
          <TextBlock x:Name="GorusOzetText" Grid.Row="2" Foreground="#AFC0CD" TextWrapping="Wrap"/>
        </Grid>
      </TabItem>

      <TabItem Header="Kesit">
        <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="KesitTipCombo" Width="150" SelectedIndex="0" SelectionChanged="Kesit_SelectionChanged">
              <ComboBoxItem Content="Boyuna (X sabit)"/><ComboBoxItem Content="Enine (Y sabit)"/>
            </ComboBox>
            <NumericUpDown x:Name="KesitKonum" Width="130" Value="0" Increment="0.25"
                           FormatString="0.##" ValueChanged="KesitKonum_ValueChanged"/>
            <TextBlock Text="m" Foreground="#AFC0CD" VerticalAlignment="Center"/>
          </StackPanel>
          <Border Grid.Row="1" BorderBrush="#263949" BorderThickness="1" CornerRadius="7">
            <salon:SalonKesitCanvas x:Name="KesitCanvas"/>
          </Border>
          <TextBlock Grid.Row="2" Text="Tavan profili değişiklikleri ana penceredeki Tavan Profili bölümünden uygulanır."
                     Foreground="#7891A4"/>
        </Grid>
      </TabItem>

      <TabItem Header="Kalite Haritası">
        <Grid Margin="12" RowDefinitions="Auto,*" RowSpacing="8">
          <TextBlock x:Name="KaliteOzetText" Foreground="#D6E3EC" FontWeight="SemiBold"/>
          <ListBox x:Name="KaliteList" Grid.Row="1" DoubleTapped="KaliteList_DoubleTapped"
                   Background="#0D1720" BorderBrush="#263949" BorderThickness="1">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="95,220,*" Margin="8,5" ColumnSpacing="10">
                  <TextBlock Text="{Binding Seviye}" Foreground="#E5B758"/>
                  <TextBlock Grid.Column="1" Text="{Binding Baslik}" Foreground="#D6E3EC" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="2" Text="{Binding Aciklama}" Foreground="#9DB0BF" TextWrapping="Wrap"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="Yansıtıcılar">
        <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
          <TextBlock Text="Sahne ile seyirci hedefi arasında yönlendirilmiş akustik bulut dizisi üretir."
                     Foreground="#AFC0CD" TextWrapping="Wrap"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Sütun" VerticalAlignment="Center" Foreground="#AFC0CD"/>
            <NumericUpDown x:Name="PanelSutun" Width="70" Minimum="1" Maximum="20" Value="3"/>
            <TextBlock Text="Sıra" VerticalAlignment="Center" Foreground="#AFC0CD"/>
            <NumericUpDown x:Name="PanelSira" Width="70" Minimum="1" Maximum="20" Value="2"/>
            <Button Content="Öneriyi Hesapla" Click="PanelOner_OnClick" Padding="12,6"/>
          </StackPanel>
          <ListBox x:Name="PanelList" Grid.Row="2" Background="#0D1720" BorderBrush="#263949" BorderThickness="1"/>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <TextBlock x:Name="PanelOzetText" Foreground="#7891A4" VerticalAlignment="Center"/>
            <Button Content="Öneriyi Salona Ekle" Click="PanelUygula_OnClick" Padding="14,7"/>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Padding="12,8" Background="#091018" BorderBrush="#263949" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="DurumText" Foreground="#8EA6B8" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="Kapat" Click="Kapat_OnClick" Padding="16,7"/>
      </Grid>
    </Border>
  </Grid>
</Window>
