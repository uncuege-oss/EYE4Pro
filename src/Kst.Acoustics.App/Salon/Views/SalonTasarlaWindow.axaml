<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Kst.Acoustics.App.Salon.ViewModels"
        xmlns:salon="clr-namespace:Kst.Acoustics.App.Salon.Views"
        x:Class="Kst.Acoustics.App.Salon.Views.SalonTasarlaWindow"
        x:DataType="vm:SalonTasarlaViewModel"
        Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#0B1118"
        KeyDown="Window_KeyDown" Title="{Binding PencereBasligi}">
    <Grid x:Name="TasarimHost"><salon:SalonCizimCanvas x:Name="CizimCanvas"/></Grid>
</Window>
