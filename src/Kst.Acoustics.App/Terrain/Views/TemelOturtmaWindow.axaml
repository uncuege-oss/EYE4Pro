<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Kst.Acoustics.App.Controls"
        x:Class="Kst.Acoustics.App.Terrain.Views.TemelOturtmaWindow"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="#060E0A"
        Title="EYE4PRO Terrain — M61 Bina Temeli Kota Oturtma">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Background="#0A1610" BorderBrush="#143222" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Click="AraziYukle_OnClick" Background="#2E7D4F" Foreground="White"
                        BorderThickness="0" CornerRadius="6" Padding="14,7" FontWeight="SemiBold"
                        Content="Arazi Yükle (.e4arazi)"/>
                <Button Click="BinaEkle_OnClick" Background="#256D7B" Foreground="White"
                        BorderThickness="0" CornerRadius="6" Padding="14,7" FontWeight="SemiBold"
                        Content="Bina Ekle (.e4bina)"/>
                <Button Click="MimariEkle_OnClick" Background="#256D7B" Foreground="White"
                        BorderThickness="0" CornerRadius="6" Padding="14,7" FontWeight="SemiBold"
                        Content="Mimari Ekle (.e4mimari)"/>
                <Button Click="BinalariTemizle_OnClick" Background="#16302010" BorderBrush="#234534"
                        Foreground="#9FD3B4" CornerRadius="6" Padding="10,7"
                        Content="Binaları Temizle"/>
                <Rectangle Width="1" Height="22" Fill="#1E3A28"/>
                <TextBlock Text="±0.00 (boş = ort. zemin):" Foreground="#9FD3B4" VerticalAlignment="Center"/>
                <TextBox x:Name="SifirKotBox" Width="100" PlaceholderText="otomatik"
                         Background="#0F1C14" Foreground="#DDF5E5" BorderBrush="#234534"/>
                <Button Click="Oturt_OnClick" Background="#1B5E36" Foreground="White"
                        BorderThickness="0" CornerRadius="6" Padding="14,7" FontWeight="SemiBold"
                        Content="Oturt"/>
                <Button Click="Kesit_OnClick" Background="#16302010" BorderBrush="#234534"
                        Foreground="#9FD3B4" CornerRadius="6" Padding="12,7"
                        Content="Kotlu Kesit"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,380">
            <controls:GeometryPreviewControl x:Name="Onizleme3D"
                                             Grid.Column="0"
                                             Projection="Isometric3D"
                                             UnitLabel="m"/>

            <Border Grid.Column="1" Background="#0A1610" BorderBrush="#143222" BorderThickness="1,0,0,0">
                <DockPanel LastChildFill="True" Margin="14">
                    <TextBlock DockPanel.Dock="Top" Text="Oturtma Sonucu"
                               Foreground="#7BD3A0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <!-- Kot düzenleme (F3) -->
                    <Border DockPanel.Dock="Bottom" Background="#0C1610" BorderBrush="#1E3A28" BorderThickness="1"
                            CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Kot Düzenle (m)" Foreground="#7BD3A0" FontWeight="SemiBold" FontSize="12"/>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Blok:" Foreground="#9FD3B4" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="BlokSecici" HorizontalAlignment="Stretch"
                                          SelectionChanged="BlokSecici_OnSelectionChanged"
                                          Background="#0F1C14" Foreground="#DDF5E5" BorderBrush="#234534"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Giriş (±0.00):" Foreground="#9FD3B4" VerticalAlignment="Center"/>
                                <TextBox  Grid.Row="0" Grid.Column="1" x:Name="GirisBox" IsReadOnly="True"
                                          Background="#0A140E" Foreground="#8FB89E" BorderBrush="#1A2C20"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Çıkış:" Foreground="#9FD3B4" VerticalAlignment="Center"/>
                                <TextBox  Grid.Row="1" Grid.Column="1" x:Name="CikisBox"
                                          Background="#0F1C14" Foreground="#DDF5E5" BorderBrush="#234534"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Yangın merd.:" Foreground="#9FD3B4" VerticalAlignment="Center"/>
                                <TextBox  Grid.Row="2" Grid.Column="1" x:Name="YanginBox"
                                          Background="#0F1C14" Foreground="#DDF5E5" BorderBrush="#234534"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Bodrum taban:" Foreground="#9FD3B4" VerticalAlignment="Center"/>
                                <TextBox  Grid.Row="3" Grid.Column="1" x:Name="BodrumBox"
                                          Background="#0F1C14" Foreground="#DDF5E5" BorderBrush="#234534"/>
                            </Grid>
                            <Button Click="KotlariUygula_OnClick" HorizontalAlignment="Stretch"
                                    Background="#1B5E36" Foreground="White" BorderThickness="0"
                                    CornerRadius="6" Padding="0,7" Content="Kotları Uygula"/>
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="SonucText" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                             Background="#0F1C14" Foreground="#DDF5E5" BorderBrush="#1E3A28"
                             Text="Önce arazi (.e4arazi) ve bina (.e4bina) yükleyin, sonra Oturt'a basın."/>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#070D0A" BorderBrush="#143222" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="DurumText" Foreground="#6FB78E" FontSize="12"
                           VerticalAlignment="Center" Text="Hazır."/>
                <Button Grid.Column="1" Content="← Terrain Modül Merkezi" Click="Geri_OnClick"
                        Background="#1B2A1F" Foreground="#9FD3B4" BorderThickness="0"
                        CornerRadius="6" Padding="12,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
