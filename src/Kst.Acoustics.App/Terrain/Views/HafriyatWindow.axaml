<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Kst.Acoustics.App.Controls"
        x:Class="Kst.Acoustics.App.Terrain.Views.HafriyatWindow"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="#060E0A"
        Title="EYE4PRO Terrain — M60 Hafriyat Hesapla">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Araç çubuğu -->
        <Border Grid.Row="0" Background="#0A1610" BorderBrush="#143222" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Click="DxfYukle_OnClick" Background="#2E7D4F" Foreground="White"
                        BorderThickness="0" CornerRadius="6" Padding="14,7" FontWeight="SemiBold"
                        Content="DXF Arazi Yükle"/>

                <Rectangle Width="1" Height="22" Fill="#1E3A28"/>

                <TextBlock Text="Hedef kot (m):" Foreground="#9FD3B4" VerticalAlignment="Center"/>
                <TextBox x:Name="HedefKotBox" Width="90" Text="0" PlaceholderText="örn. 540"
                         Background="#0F1C14" Foreground="#DDF5E5" BorderBrush="#2E7D4F"/>

                <TextBlock Text="Kabarma %:" Foreground="#9FD3B4" VerticalAlignment="Center"/>
                <TextBox x:Name="KabarmaBox" Width="60" Text="25"
                         Background="#0F1C14" Foreground="#DDF5E5" BorderBrush="#234534"/>
                <TextBlock Text="Sıkışma %:" Foreground="#9FD3B4" VerticalAlignment="Center"/>
                <TextBox x:Name="SikismaBox" Width="60" Text="10"
                         Background="#0F1C14" Foreground="#DDF5E5" BorderBrush="#234534"/>

                <Button Click="Hesapla_OnClick" Background="#1B5E36" Foreground="White"
                        BorderThickness="0" CornerRadius="6" Padding="14,7" FontWeight="SemiBold"
                        Content="Hesapla"/>
                <Button Click="AraziKaydet_OnClick" Background="#16302010" BorderBrush="#2E7D4F"
                        Foreground="#9FD3B4" CornerRadius="6" Padding="12,7"
                        Content=".e4arazi Kaydet"/>
            </StackPanel>
        </Border>

        <!-- 3D önizleme + rapor -->
        <Grid Grid.Row="1" ColumnDefinitions="*,360">
            <controls:GeometryPreviewControl x:Name="Onizleme3D"
                                             Grid.Column="0"
                                             Projection="Isometric3D"
                                             UnitLabel="m"/>

            <Border Grid.Column="1" Background="#0A1610" BorderBrush="#143222" BorderThickness="1,0,0,0">
                <DockPanel LastChildFill="True" Margin="14">
                    <TextBlock DockPanel.Dock="Top" Text="Hafriyat Raporu"
                               Foreground="#7BD3A0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBox x:Name="RaporText" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                             Background="#0F1C14" Foreground="#DDF5E5" BorderBrush="#1E3A28"
                             Text="DXF arazi dosyası yükleyin, hedef kot girin ve Hesapla'ya basın."/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Durum çubuğu -->
        <Border Grid.Row="2" Background="#070D0A" BorderBrush="#143222" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="DurumText" Foreground="#6FB78E" FontSize="12"
                           VerticalAlignment="Center" Text="Hazır."/>
                <Button Grid.Column="1" Content="← Terrain Modül Merkezi" Click="Geri_OnClick"
                        Background="#1B2A1F" Foreground="#9FD3B4" BorderThickness="0"
                        CornerRadius="6" Padding="12,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
