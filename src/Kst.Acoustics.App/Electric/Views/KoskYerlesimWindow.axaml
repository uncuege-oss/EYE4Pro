<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kst.Acoustics.App.Electric.Views.KoskYerlesimWindow"
        Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#080F0A"
        Title="Köşk Yerleşimi (Plan)">

    <Grid RowDefinitions="Auto,*,Auto" Margin="14">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,10">
            <TextBlock Text="🏭 Köşk İçi Yerleşim — Plan Görünümü"
                       Foreground="#E0A848" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="OlcuText" Foreground="#A0C888" FontSize="12"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#0C160C" BorderBrush="#2A4018" BorderThickness="1" ClipToBounds="True">
            <Canvas x:Name="YerlesimCanvas" Background="Transparent"/>
        </Border>

        <Button Grid.Row="2" Content="Kapat" HorizontalAlignment="Right" Padding="16,6" Margin="0,10,0,0"
                Background="#1A2A1A" Foreground="#E0F0D0" Click="Kapat_OnClick"/>
    </Grid>
</Window>
