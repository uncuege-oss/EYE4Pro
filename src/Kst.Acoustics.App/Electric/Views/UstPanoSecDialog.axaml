<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kst.Acoustics.App.Electric.Views.UstPanoSecDialog"
        Width="460" Height="540"
        CanResize="True"
        MinWidth="360" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="#080F0A"
        Title="Üst Panoyu Değiştir">
    <Window.Styles>
        <Style Selector="TextBlock.lbl">
            <Setter Property="Foreground" Value="#7AA060"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#101C10"/>
            <Setter Property="Foreground" Value="#D0E8C0"/>
            <Setter Property="BorderBrush" Value="#2A4A20"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0" x:Name="BaslikText" Text="Üst Panoyu Değiştir"
                   Foreground="#C8E4B0" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" x:Name="BilgiText" Classes="lbl"
                   Text="Yeni üst panoyu seçin. Bağlantı kabloya çevrilir."
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBox Grid.Row="2" x:Name="AramaBox" PlaceholderText="Pano ara..." Margin="0,0,0,8"/>

        <ListBox Grid.Row="3" x:Name="PanoListe" Background="#0A140A"
                 BorderBrush="#2A4A20" BorderThickness="1"
                 x:CompileBindings="False"
                 DoubleTapped="PanoListe_OnDoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Etiket}" Foreground="#D0E8C0" FontSize="13"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="İptal" Click="Iptal_OnClick"
                    Background="#162A10" Foreground="#A0C888" BorderBrush="#2A4A20"/>
            <Button Content="Bağla" Click="Bagla_OnClick"
                    Background="#3A7A18" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
