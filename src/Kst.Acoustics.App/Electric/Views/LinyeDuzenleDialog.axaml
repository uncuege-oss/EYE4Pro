<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kst.Acoustics.App.Electric.Views.LinyeDuzenleDialog"
        Width="500" Height="540"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#080F0A"
        Title="Linye Düzenle">
    <Window.Styles>
        <Style Selector="TextBlock.lbl">
            <Setter Property="Foreground" Value="#7AA060"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox, ComboBox">
            <Setter Property="Background" Value="#101C10"/>
            <Setter Property="Foreground" Value="#D0E8C0"/>
            <Setter Property="BorderBrush" Value="#2A4A20"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0" x:Name="BaslikText" Text="Linye Düzenle"
                   Foreground="#C8E4B0" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
            <StackPanel Spacing="4">
                <TextBlock Classes="lbl" Text="Linye No"/>
                <TextBox x:Name="LinyeNoBox"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Classes="lbl" Text="Yük Tipi"/>
                <ComboBox x:Name="YukTipiCombo" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Classes="lbl" Text="Faz Tipi"/>
                <ComboBox x:Name="FazTipiCombo" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Monofaze"/>
                    <ComboBoxItem Content="Trifaze"/>
                </ComboBox>
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="lbl" Text="Sorti Sayısı"/>
                    <TextBox x:Name="SortiBox"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="lbl" Text="Birim Güç (W)"/>
                    <TextBox x:Name="GucBox"/>
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="lbl" Text="Talep Faktörü"/>
                    <TextBox x:Name="TalepBox"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="lbl" Text="Kablo Mesafesi (m)"/>
                    <TextBox x:Name="KabloMesafeBox"/>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock Classes="lbl" Text="Sigorta Cinsi"/>
                <ComboBox x:Name="SigortaCinsiCombo" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="B"/>
                    <ComboBoxItem Content="C"/>
                    <ComboBoxItem Content="D"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Classes="lbl" Text="Açıklama"/>
                <TextBox x:Name="AciklamaBox"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="İptal" Click="Iptal_OnClick"
                    Background="#162A10" Foreground="#A0C888" BorderBrush="#2A4A20"/>
            <Button Content="Kaydet" Click="Kaydet_OnClick"
                    Background="#3A7A18" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
