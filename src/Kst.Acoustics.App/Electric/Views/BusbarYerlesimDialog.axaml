<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kst.Acoustics.App.Electric.Views.BusbarYerlesimDialog"
        Width="940" Height="720" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#080F0A"
        Title="Busbar Kat ve Çıkış Yerleşimi">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#101C10"/>
            <Setter Property="Foreground" Value="#D0E8C0"/>
            <Setter Property="BorderBrush" Value="#2A4A20"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="BaslikText" Foreground="#C8E4B0" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="OzetText" Foreground="#82B86A" FontSize="12"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,10" Padding="12,9" CornerRadius="5"
                Background="#0C160C" BorderBrush="#1F3A1A" BorderThickness="1">
            <TextBlock Foreground="#9BC784" FontSize="12" TextWrapping="Wrap"
                       Text="Her katta bulunan busbar uzunluğunu ve çıkış kutusunun yalnız o katın başlangıcından ölçülen metresini girin. Hesaplarda kullanılan toplam mesafe otomatik oluşturulur."/>
        </Border>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="KatlarPanel" Spacing="10" Margin="0,0,8,0"/>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
            <TextBlock x:Name="DurumText" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="#E8B56A" FontSize="12" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="İptal" Click="Iptal_OnClick"
                        Background="#162A10" Foreground="#A0C888" BorderBrush="#2A4A20"/>
                <Button Content="Kat Yerleşimini Kaydet" Click="Kaydet_OnClick"
                        Background="#3A7A18" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
