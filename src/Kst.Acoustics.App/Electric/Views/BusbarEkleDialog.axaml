<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kst.Acoustics.App.Electric.Views.BusbarEkleDialog"
        Width="560" Height="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#080F0A"
        Title="Busbar Hattı Ekle">
    <Window.Styles>
        <Style Selector="TextBlock.lbl">
            <Setter Property="Foreground" Value="#7AA060"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox, ComboBox">
            <Setter Property="Background" Value="#101C10"/>
            <Setter Property="Foreground" Value="#D0E8C0"/>
            <Setter Property="BorderBrush" Value="#2A4A20"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0" x:Name="BaslikText" Text="Yeni Busbar Hattı"
                   Foreground="#C8E4B0" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Spacing="10">
            <StackPanel Spacing="4">
                <TextBlock Classes="lbl" Text="Busbar Adı"/>
                <TextBox x:Name="BusbarAdBox" Text="Busbar-1"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Classes="lbl" Text="Çıktığı Ana/Üst Pano"/>
                <ComboBox x:Name="UstPanoCombo" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <CheckBox x:Name="OtomatikTipCheck"
                      Content="Amperajı ihtiyaca göre otomatik belirle"
                      Foreground="#A0C888"
                      IsChecked="True"/>

            <StackPanel Spacing="4">
                <TextBlock Classes="lbl" Text="Busbar Tipi (otomatik kapalıysa kullanılır)"/>
                <ComboBox x:Name="BusbarTipiCombo" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Classes="lbl" Text="Toplam Busbar Boyu (m)"/>
                <TextBox x:Name="UzunlukBox" Text="20"/>
            </StackPanel>

            <Border Background="#0C160C" CornerRadius="4" Padding="10" BorderBrush="#1A3018" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Busbar ayarı:"
                               Foreground="#A0C888" FontSize="11"/>
                    <TextBlock Text="• Otomatik amper açıkken tip, bağlı panoların toplam akımına göre seçilir"
                               Foreground="#8AA868" FontSize="11"/>
                    <TextBlock Text="• Toplam boy, elle girilen en uzaktaki çıkış kutusunu kapsayacak değerin altına düşmez"
                               Foreground="#8AA868" FontSize="11"/>
                    <TextBlock Text="• Çıkış kutusu mesafeleri kutunun üstüne tıklanarak elle düzenlenir"
                               Foreground="#8AA868" FontSize="11"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="İptal" Click="Iptal_OnClick"
                    Background="#162A10" Foreground="#A0C888" BorderBrush="#2A4A20"/>
            <Button x:Name="KaydetButton" Content="+ Busbar Oluştur" Click="Ekle_OnClick"
                    Background="#3A7A18" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
