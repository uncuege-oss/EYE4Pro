<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kst.Acoustics.App.Electric.Views.JeneratorEkleDialog"
        Width="720" Height="740"
        WindowStartupLocation="CenterOwner"
        Background="#080F0A"
        CanResize="False"
        Title="Jeneratör Ekle / Düzenle">

    <Window.Styles>
        <Style Selector="TextBox, ComboBox">
            <Setter Property="Background" Value="#0F1A0C"/>
            <Setter Property="Foreground" Value="#E0F0D0"/>
            <Setter Property="BorderBrush" Value="#2A4018"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#A0C888"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0" x:Name="BaslikText" Text="⚡ Jeneratör Ekle"
                   Foreground="#B8E068" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10">
                <TextBlock Classes="label" Text="Besleme Kapsamı:"/>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton x:Name="KapsamTesis" GroupName="JenKapsam" Content="Tesis Geneli (Ana Pano)" Foreground="#E0F0D0" IsChecked="True"/>
                    <RadioButton x:Name="KapsamLokal" GroupName="JenKapsam" Content="Lokal Bölge (Tali Pano)" Foreground="#E0F0D0"/>
                </StackPanel>

                <TextBlock x:Name="HedefPanoLabel" Classes="label" Text="Beslenen Pano:" Margin="0,6,0,0"/>
                <ComboBox x:Name="HedefPanoCombo" HorizontalAlignment="Stretch" IsEnabled="False"/>

                <TextBlock Classes="label" Text="Hedef Pano:" Margin="0,6,0,0"/>
                <TextBlock x:Name="AnaPanoText" Foreground="#E0F0D0" FontWeight="SemiBold"/>

                <TextBlock Classes="label" Text="Çalışma Modu:" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton x:Name="ModStandby" GroupName="JenMod" Content="Standby (ESP — acil yedek)" Foreground="#E0F0D0" IsChecked="True"/>
                    <RadioButton x:Name="ModPrime"   GroupName="JenMod" Content="Prime (PRP — sürekli)" Foreground="#E0F0D0"/>
                </StackPanel>

                <TextBlock Classes="label" Text="Emniyet Faktörü (1.0 - 2.0):" Margin="0,6,0,0"/>
                <TextBox x:Name="EmniyetFaktoruBox" Text="1.25"/>

                <TextBlock Classes="label" Text="Jeneratör Katı (boş = hedef pano katı):" Margin="0,6,0,0"/>
                <ComboBox x:Name="KatCombo" HorizontalAlignment="Stretch"/>

                <TextBlock Classes="label" Text="Hesaplanan Yük:" Margin="0,6,0,0"/>
                <TextBlock x:Name="HesapYukText" Foreground="#E0F0D0" FontWeight="SemiBold"/>

                <TextBlock Classes="label" Text="Jeneratör Ünitesi Ekle (farklı güçler seçilebilir):" Margin="0,6,0,0"/>
                <ComboBox x:Name="JeneratorCombo" HorizontalAlignment="Stretch"/>
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Content="+ Listeye Ekle" Padding="10,4"
                            Background="#284A18" Foreground="#E0F0D0"
                            Click="ListeyeEkle_OnClick"/>
                    <Button Grid.Column="1" Content="Seçileni Sil" Padding="10,4"
                            Background="#5A2418" Foreground="#FFE0D0"
                            Click="ListedenSil_OnClick"/>
                    <TextBlock Grid.Column="2" x:Name="ToplamKapasiteText" Foreground="#D8C070"
                               FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
                <Border Background="#071208" BorderBrush="#284A18" BorderThickness="1" CornerRadius="4" Padding="4">
                    <DataGrid x:Name="JeneratorListBox" Height="150" Background="#071208" Foreground="#E0F0D0"
                              AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="False"
                              GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Jeneratör" Binding="{ReflectionBinding Ad}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Kapasite" Binding="{ReflectionBinding Kapasite}" Width="170" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="Dışarıda" Binding="{ReflectionBinding DisMekandaMi, Mode=TwoWay}" Width="85"/>
                            <DataGridTextColumn Header="Jeneratör → Senkron (m)"
                                                Binding="{ReflectionBinding KabloMesafeText, Mode=TwoWay}" Width="155"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <TextBlock x:Name="OnerilenJenText" Foreground="#7AA060" FontSize="11"/>

                <TextBlock Classes="label" Text="Senkron Pano → Transfer / Ara / Hedef Pano Kablo Mesafesi (m):" Margin="0,6,0,0"/>
                <TextBox x:Name="SenkronHedefMesafeBox" Text="10"/>

                <TextBlock Classes="label" Text="Senkron / Transfer Şalteri (boş = otomatik tayin):" Margin="0,6,0,0"/>
                <ComboBox x:Name="TransferSalterCombo" HorizontalAlignment="Stretch"/>
                <TextBlock x:Name="OnerilenSalterText" Foreground="#7AA060" FontSize="11"/>

                <Border Background="#0E1A2A" CornerRadius="4" Padding="8" Margin="0,10,0,0">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Bilgilendirme" Foreground="#80A0E0" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Foreground="#A0C0E0" FontSize="11" TextWrapping="Wrap"
                                   Text="• PRP: Sürekli işletme, yük değişkenli, sınırsız çalışma saati.&#x0a;• ESP: Acil yedek, sınırlı yıllık çalışma saati; PRP × 1.1 ≈ ESP.&#x0a;• Seçilen üniteler senkron panosunda birleştirilir; toplam kW/kVA yükü birlikte karşılar."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0" x:Name="SilButton" Content="🗑 Sil" Padding="14,6"
                    Background="#7A2018" Foreground="White"
                    IsVisible="False"
                    Click="Sil_OnClick"/>
            <Button Grid.Column="1" Content="İptal" Padding="14,6" Background="#1A2A1A" Foreground="#E0F0D0"
                    Margin="0,0,8,0" Click="Iptal_OnClick"/>
            <Button Grid.Column="2" x:Name="KaydetButton" Content="Kaydet" Padding="14,6" Background="#3A7A18" Foreground="White"
                    Click="Kaydet_OnClick"/>
        </Grid>
    </Grid>
</Window>
