<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kst.Acoustics.App.Electric.BasitProjeCiz.Views.KurallarWindow"
        Width="720" Height="580"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#081009"
        Title="Aktif Kurallar">

    <Window.Styles>
        <Style Selector="TextBlock.baslik">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#AADDAA"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style Selector="TextBlock.kural">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#CCDDCC"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.sembol">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFDD88"/>
            <Setter Property="MinWidth" Value="180"/>
        </Style>
        <Style Selector="TextBlock.aciklama">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#CCDDCC"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.grup">
            <Setter Property="Background" Value="#0C1A0D"/>
            <Setter Property="BorderBrush" Value="#1E3A1E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Border.ayirici">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#1E3A1E"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </Window.Styles>

    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top"
                   Text="Programın otomatik uyguladığı bağlantı ve yerleşim kuralları"
                   Foreground="#78A060" FontSize="11" Margin="0,0,0,10"/>

        <Button DockPanel.Dock="Bottom" Content="Kapat" Click="Kapat_OnClick"
                HorizontalAlignment="Right" Margin="0,10,0,0"
                Background="#1E3A12" Foreground="#DDEED2"
                BorderBrush="#245424" BorderThickness="1" Padding="20,6"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="0">

                <!-- PRİZ BAĞLANTI KURALLARI -->
                <Border Classes="grup">
                    <StackPanel>
                        <TextBlock Classes="baslik" Text="Priz Bağlantı Kuralları" Margin="0,0,0,6"/>
                        <Border Classes="ayirici"/>

                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol" Text="Müstakil Priz"/>
                            <TextBlock Grid.Column="2" Classes="aciklama"
                                       Text="Doğrudan panoya bağlanır. Buat almaz, ayrı linye alır."/>
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol" Text="Trifaze Priz"/>
                            <TextBlock Grid.Column="2" Classes="aciklama"
                                       Text="Doğrudan panoya bağlanır. Buat almaz, ayrı 3-fazlı linye alır."/>
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol" Text="UPS Prizi (tüm varyantlar)"/>
                            <TextBlock Grid.Column="2" Classes="aciklama"
                                       Text="Doğrudan panoya bağlanır. Buat almaz, ayrı UPS linyesi alır."/>
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol" Text="Kombine Priz Kutusu"/>
                            <TextBlock Grid.Column="2" Classes="aciklama"
                                       Text="Doğrudan panoya bağlanır. Buat almaz, ayrı linye alır."/>
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol"
                                       Text="Normal / Kapaklı / Sıva Üstü / Tavan / USB'li / İkili / Üçlü Priz"/>
                            <TextBlock Grid.Column="2" Classes="aciklama"
                                       Text="Otomatik priz buatı alır. Bir priz buatına en fazla 7 priz bağlanır."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- BUAT KURALLARI -->
                <Border Classes="grup">
                    <StackPanel>
                        <TextBlock Classes="baslik" Text="Buat Kuralları" Margin="0,0,0,6"/>
                        <Border Classes="ayirici"/>

                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol" Text="Aydınlatma Buatı"/>
                            <TextBlock Grid.Column="2" Classes="aciklama"
                                       Text="Her 4 anahtara 1 buat otomatik oluşturulur. Armatürler en yakın buata atanır."/>
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol" Text="Priz Buatı"/>
                            <TextBlock Grid.Column="2" Classes="aciklama"
                                       Text="Bir odadaki doğrudan-panoya-gitmeyen prizler ⌈n / 7⌉ priz buatına dengeli bölünür."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PANO HİYERARŞİSİ -->
                <Border Classes="grup">
                    <StackPanel>
                        <TextBlock Classes="baslik" Text="Pano Seçim Hiyerarşisi" Margin="0,0,0,6"/>
                        <Border Classes="ayirici"/>

                        <TextBlock Classes="kural" Text="Bir buat hangi panoya bağlanacağını şu sırayla belirler:"/>
                        <TextBlock Classes="kural" Margin="12,2,0,2"
                                   Text="1) Buatın bulunduğu mahaldeki TALİ pano → bu oda için atanmış tali pano tercih edilir."/>
                        <TextBlock Classes="kural" Margin="12,2,0,2"
                                   Text="2) Mahalde tali pano yoksa → en yakın KAT panosu."/>
                        <TextBlock Classes="kural" Margin="12,2,0,2"
                                   Text="3) Kat panosu da yoksa → ANA hariç en yakın pano. ANA pano yoksa herhangi bir pano."/>
                    </StackPanel>
                </Border>

                <!-- SİGORTA VE ELEKTRİK KURALLARI -->
                <Border Classes="grup">
                    <StackPanel>
                        <TextBlock Classes="baslik" Text="Sigorta ve Elektrik Değerleri (IEC 60898)" Margin="0,0,0,6"/>
                        <Border Classes="ayirici"/>

                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol" Text="Monofaze Gerilim"/>
                            <TextBlock Grid.Column="2" Classes="aciklama" Text="230 V"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol" Text="Hat Gerilimi (Trifaze)"/>
                            <TextBlock Grid.Column="2" Classes="aciklama" Text="400 V"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol" Text="Güç Katsayısı (cos φ)"/>
                            <TextBlock Grid.Column="2" Classes="aciklama" Text="0.95"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol" Text="Standart Sigorta Değerleri"/>
                            <TextBlock Grid.Column="2" Classes="aciklama"
                                       Text="6, 10, 13, 16, 20, 25, 32, 40, 50, 63, 80, 100, 125, 160, 200, 250 A"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol" Text="Sigorta Tipi"/>
                            <TextBlock Grid.Column="2" Classes="aciklama"
                                       Text="B (resistif / aydınlatma), C (motor/trafo), D (ağır motor). Hesaplanan akımın üstündeki standart değere yuvarlanır."/>
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol" Text="Kesme Kapasitesi"/>
                            <TextBlock Grid.Column="2" Classes="aciklama"
                                       Text="Giriş akımı &gt; 100 A → 10 kA | Giriş akımı ≤ 100 A → 6 kA"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- OTOMATİK YERLEŞİM MESAFELERİ -->
                <Border Classes="grup">
                    <StackPanel>
                        <TextBlock Classes="baslik" Text="Otomatik Yerleşim Mesafeleri" Margin="0,0,0,6"/>
                        <Border Classes="ayirici"/>

                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol" Text="Duvar giriş mesafesi"/>
                            <TextBlock Grid.Column="2" Classes="aciklama" Text="0.12 m — Elemanların duvara olan minimum yaklaşma payı."/>
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol" Text="Açıklık koruma"/>
                            <TextBlock Grid.Column="2" Classes="aciklama" Text="0.40 m — Kapı/pencere açıklıklarından eleman bırakılmaz."/>
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol" Text="Eleman minimum aralığı"/>
                            <TextBlock Grid.Column="2" Classes="aciklama" Text="0.25 m — İki eleman arasındaki minimum boşluk."/>
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Classes="sembol" Text="Armatür – duvar minimum"/>
                            <TextBlock Grid.Column="2" Classes="aciklama" Text="0.50 m — Armatürün odanın iç duvarına minimum mesafesi."/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
