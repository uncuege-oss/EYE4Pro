<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kst.Acoustics.App.Electric.ZayifAkimTekHat"
        x:Class="Kst.Acoustics.App.Electric.ZayifAkimTekHat.ZayifAkimKutuphaneWindow"
        x:DataType="vm:ZayifAkimKutuphaneViewModel"
        x:CompileBindings="False"
        Title="M13 Cihaz ve Kablo Kütüphanesi"
        Width="1100" Height="720" MinWidth="820" MinHeight="520"
        Background="#08100B" WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.baslik"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#D8F0C8"/></Style>
    <Style Selector="TextBlock.aciklama"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#7FA889"/></Style>
    <Style Selector="Button"><Setter Property="Background" Value="#18301B"/><Setter Property="Foreground" Value="#D6EECB"/><Setter Property="BorderBrush" Value="#315A35"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="10,6"/></Style>
    <Style Selector="Button.danger"><Setter Property="Background" Value="#521C1C"/><Setter Property="BorderBrush" Value="#823030"/><Setter Property="Foreground" Value="#FFDADA"/></Style>
    <Style Selector="ComboBox"><Setter Property="Background" Value="#102016"/><Setter Property="Foreground" Value="#E0F1D8"/><Setter Property="BorderBrush" Value="#315A35"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#102016"/><Setter Property="Foreground" Value="#E0F1D8"/><Setter Property="BorderBrush" Value="#315A35"/></Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16" RowSpacing="12">
    <Grid Grid.Row="0" ColumnDefinitions="*,360">
      <StackPanel>
        <TextBlock Text="CİHAZ VE KABLO KÜTÜPHANESİ" Classes="baslik"/>
        <TextBlock Text="Yerleşik kayıtlar salt okunurdur. Kullanıcı kayıtları projeyle birlikte kaydedilir." Classes="aciklama"/>
      </StackPanel>
      <ComboBox Grid.Column="1" ItemsSource="{Binding AltBasliklar}" SelectedItem="{Binding SeciliAltBaslik}">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Ad}"/></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <Border Grid.Row="1" Background="#102016" BorderBrush="#29452D" BorderThickness="1" CornerRadius="5" Padding="10">
      <TextBlock Text="Seçili alt başlığın kullandığı yerleşik ve kullanıcı tanımlı katalog kalemleri" Classes="aciklama"/>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
      <Border Background="#0C1710" BorderBrush="#29452D" BorderThickness="1" CornerRadius="6" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
            <TextBlock Text="CİHAZLAR" Classes="baslik" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="+ Kullanıcı Cihazı" Command="{Binding CihazEkleCommand}" Margin="4,0"/>
            <Button Grid.Column="2" Content="Sil" Command="{Binding CihazSilCommand}" Classes="danger"/>
          </Grid>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Cihazlar}" SelectedItem="{Binding SeciliCihaz}"
                    AutoGenerateColumns="False" GridLinesVisibility="Horizontal" IsReadOnly="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Cihaz" Width="*">
                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Ad}" IsReadOnly="{Binding Yerlesik}" BorderThickness="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Kaynak" Binding="{Binding KaynakText}" Width="150" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="#0C1710" BorderBrush="#29452D" BorderThickness="1" CornerRadius="6" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
            <TextBlock Text="KABLOLAR" Classes="baslik" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="+ Kullanıcı Kablosu" Command="{Binding KabloEkleCommand}" Margin="4,0"/>
            <Button Grid.Column="2" Content="Sil" Command="{Binding KabloSilCommand}" Classes="danger"/>
          </Grid>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Kablolar}" SelectedItem="{Binding SeciliKablo}"
                    AutoGenerateColumns="False" GridLinesVisibility="Horizontal" IsReadOnly="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Kablo" Width="*">
                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Ad}" IsReadOnly="{Binding Yerlesik}" BorderThickness="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Kaynak" Binding="{Binding KaynakText}" Width="150" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>

    <Button Grid.Row="3" Content="Kapat" Click="Kapat_OnClick" HorizontalAlignment="Right" MinWidth="100"/>
  </Grid>
</Window>
