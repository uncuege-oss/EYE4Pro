<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**/._*.cs" />
    <None Remove="**/._*" />
    <None Update="Data/akustik_malzeme_kutuphanesi_master_tekil.xlsx"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="BuildingAcoustics/Database/buildingelements.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="Electric/Data/*.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- M12 gömülü elektrik sembol şablonu: açılışta otomatik uygulanır (single-file yayında da çalışır). -->
    <EmbeddedResource Include="Electric/BasitProjeCiz/Sablonlar/EYE4PRO_Sembol_Sablonu.dxf">
      <LogicalName>EYE4PRO_Sembol_Sablonu.dxf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="FftSharp" Version="2.1.0" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="netDxf" Version="2022.11.2" />
    <PackageReference Include="Triangle" Version="0.0.6-Beta3" />
  </ItemGroup>
</Project>
